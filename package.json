{
  "name": "phantombuster-recipe-scraper",
  "version": "1.0.0",
  "description": "Create a Phantom",
  "main": "index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/types && cp src/types/phantombuster.js dist/types/",
    "build:bundle": "esbuild src/main.ts --bundle --platform=node --outfile=dist/bundle.js",
    "start": "node -r tsconfig-paths/register dist/main.js",
    "start:bundle": "node dist/bundle.js",
    "test": "jest --coverage",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json,css,md}'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "json2csv": "^6.0.0-alpha.2",
    "minimist": "^1.2.8",
    "puppeteer": "^20.9.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-recaptcha": "^3.6.8",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/json2csv": "^5.0.7",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
